{
  "name": "@thisdot/claude-code-context-status-line",
  "version": "0.1.0",
  "description": "Restore context visibility for AWS Bedrock users in Claude Code",
  "type": "module",
  "main": "src/context-status.js",
  "bin": {
    "claude-code-context-status-line": "src/context-status.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "node --test tests/context-status.test.js",
    "test:coverage": "node --test --experimental-test-coverage tests/context-status.test.js",
    "benchmark": "node --test tests/benchmark.test.js",
    "test:all": "node --test tests/*.test.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "prepublishOnly": "pnpm run lint && pnpm run test"
  },
  "keywords": [
    "claude-code",
    "aws-bedrock",
    "context",
    "status-line"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisdot/claude-code-context-status-line.git"
  },
  "author": "This Dot, Inc.",
  "bugs": {
    "url": "https://github.com/thisdot/claude-code-context-status-line/issues"
  },
  "homepage": "https://github.com/thisdot/claude-code-context-status-line#readme"
}
