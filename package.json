{
  "name": "@thisdot/claude-code-context-status-line",
  "version": "0.1.0",
  "description": "Restore context visibility for AWS Bedrock users in Claude Code",
  "type": "module",
  "main": "src/context-status.js",
  "bin": {
    "claude-code-context-status-line": "src/context-status.js"
  },
  "files": [
    "src/"
  ],
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testPathIgnorePatterns=\"benchmark.test.js\"",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --testPathIgnorePatterns=\"benchmark.test.js\"",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "benchmark": "node --experimental-vm-modules node_modules/jest/bin/jest.js --testNamePattern=\"benchmark\" --verbose",
    "prepublishOnly": "npm run lint && npm run test"
  },
  "keywords": [
    "claude-code",
    "aws-bedrock",
    "context",
    "status-line",
    "security",
    "performance",
    "caching"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "benchmark": "^2.1.4"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": [
      "src/context-status.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js",
      "**/?(*.)+(spec|test).js"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "coverageThreshold": {
      "global": {
        "branches": 70,
        "functions": 70,
        "lines": 70,
        "statements": 70
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thisdot/claude-code-context-status-line.git"
  },
  "author": "",
  "bugs": {
    "url": "https://github.com/thisdot/claude-code-context-status-line/issues"
  },
  "homepage": "https://github.com/thisdot/claude-code-context-status-line#readme"
}
